{
  "title": "青庭 · Koi Courtyard",
  "slug": "01-koi-courtyard",
  "description": "在青绿水庭中投饵、画水流、放置并移动荷叶，组合改变鱼群的路径。清晨与薄暮各有一套完整水色。",
  "controls": [
    {
      "id": "mode-feed",
      "action": "点按与慢划投饵，观察鱼群聚散"
    },
    {
      "id": "mode-current",
      "action": "拖画水平、环形或交叉水流"
    },
    {
      "id": "mode-lily",
      "action": "轻点空处新增荷叶，拖动已有叶子改变绕行"
    },
    {
      "id": "add-fish",
      "action": "添加一尾鱼，最多28尾"
    },
    {
      "id": "palette",
      "action": "切换清晨与薄暮"
    },
    {
      "id": "clear-current",
      "action": "清除食物和水流，保留鱼与荷叶"
    },
    {
      "id": "reset",
      "action": "恢复初始庭院"
    }
  ],
  "testControls": [
    "#mode-feed",
    "#mode-current",
    "#mode-lily",
    "#add-fish",
    "#palette",
    "#clear-current"
  ],
  "testNotes": "投饵慢划形成食物路径；水流拖画交叉与环形；荷叶模式拖初始左侧荷叶并在空处加叶；加鱼至上限；静水；薄暮与清晨两套色；重置两次与resize两次。",
  "qa": {
    "canvas": "#art",
    "telemetry": "#qa",
    "suggestedSequence": [
      "投饵画弧线",
      "水流画交叉与环形",
      "放三片荷叶并拖动",
      "连续添鱼至上限",
      "切换薄暮与清晨",
      "静水、重置及窗口调整"
    ],
    "caps": {
      "fish": 28,
      "food": 48,
      "flows": 100,
