    }
  ],
  "code_reuse": "None. Original procedural drawing and interaction code.",
  "asset_reuse": "None. No external images, fonts or audio.",
  "license": "MIT (original implementation); see LICENSE.txt",
  "audio": "none",
  "testControls": [
    "#poppy",
    "#plant",
    "#wind",
    "#harvest",
    "#gather",
    "#move",
    "#prune",
    "#season"
  ],
  "testNotes": "采花需点实际花头（花茎上端）；gather将花束插入右侧陶瓶，再move拖花头可逐枝重排。",
